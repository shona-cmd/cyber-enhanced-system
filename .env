# Environment Configuration for Naashon Secure IoT
# Copy this file and update with your production values

# Flask Configuration
SECRET_KEY=your-secure-random-key-here-change-in-production
FLASK_ENV=production
DEBUG=False

# Database Configuration
SQLALCHEMY_DATABASE_URI=sqlite:///app.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# User Credentials (Change these in production!)
ADMIN_PASSWORD=secure-admin-password-change-me
HOD_PASSWORD=secure-hod-password-change-me
USER_PASSWORD=secure-user-password-change-me

# Security Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=30

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key-here

# IoT Configuration
MAX_DEVICES=1000
ANOMALY_THRESHOLD=0.85

# Network Configuration
LOCAL_IP=192.168.1.100
SUBNET_MASK=255.255.255.0
DEFAULT_GATEWAY=192.168.1.1
DNS_SUFFIX=local

# Monitoring
LOG_LEVEL=INFO
ALERTING_ENABLED=True

# Compliance
GDPR_COMPLIANCE_ENABLED=True
COMPLIANCE_REPORTING_ENABLED=True
